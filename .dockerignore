# Deny by default: only files required by the development and production
# Dockerfiles are sent to the Docker daemon or remote BuildKit builder.
**

!.dockerignore
!Dockerfile

!dockerfiles/
!dockerfiles/Dockerfile-for-frpc
!dockerfiles/Dockerfile-for-frps

!go.mod
!go.sum

!assets/
!assets/**
!client/
!client/**
!cmd/
!cmd/**
!pkg/
!pkg/**
!server/
!server/**

!web/
!web/package.json
!web/package-lock.json
!web/shared/
!web/shared/**
!web/frpc/
!web/frpc/**
!web/frps/
!web/frps/**

# Defense in depth for sensitive or generated files inside allowed trees.
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.crt
**/id_rsa*
**/id_ed25519*
**/credentials*.json
**/service-account*.json
**/kubeconfig*
**/*.kubeconfig
**/secret*.yaml
**/secret*.yml
**/secrets*.yaml
**/secrets*.yml
**/.npmrc
**/.pypirc
**/.netrc
**/.aws/
**/.ssh/
**/.docker/
**/node_modules/
**/dist/
**/*_test.go
web/shared/test/
web/frpc/test/
web/frps/test/
**/*.tar
**/*.tar.gz
**/*.zip
**/*.log
**/*.prof
